<?xml version="1.0" encoding="utf-8"?>
        <RelativeLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/offwhite"
            android:clickable="true"
            android:focusable="true"
            tools:context=".Activity.SignInActivity">



                <!-- Logo -->
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/gossip_logo"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"/>

                <!-- App Name -->
                <TextView
                    android:id="@+id/appName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gossip"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/navyblue"
                    android:layout_below="@id/logo"
                    android:layout_centerHorizontal="true"/>

                <!-- Tagline -->
                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Talk with your friends and family"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:layout_below="@id/appName"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"/>

                <!-- Sign In Heading -->
                <TextView
                    android:id="@+id/signInHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Let's Sign In!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginLeft="10dp"
                    android:layout_below="@id/tagline"
                    android:layout_marginTop="30dp"
                    android:layout_alignParentStart="true"/>



                <!-- Email Input -->
                <EditText
                    android:id="@+id/email_address"
                    android:layout_width="350dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/signInHeading"
                    android:layout_marginTop="20dp"
                    android:hint="Enter email"
                    android:inputType="textEmailAddress"
                    android:paddingLeft="15dp"
                    android:elevation="5dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/common_google_signin_btn_text_light"
                    android:background="@drawable/editbg"
                    android:drawablePadding="10dp"/>
                <EditText
                    android:id="@+id/user_name"
                    android:layout_width="350dp"
                    android:layout_height="50dp"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/email_address"
                    android:layout_marginTop="15dp"
                    android:elevation="5dp"
                    android:hint="Username"
                    android:paddingLeft="15dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/common_google_signin_btn_text_light"
                    android:background="@drawable/editbg"
                    android:drawablePadding="10dp"/>



                <EditText
                    android:id="@+id/email_password"
                    android:layout_width="350dp"
                    android:layout_height="50dp"
                    android:layout_below="@id/user_name"
                    android:layout_marginTop="15dp"
                    android:hint="password"
                    android:paddingLeft="15dp"
                    android:inputType="textPassword"
                    android:elevation="5dp"
                    android:textColorHint="@color/common_google_signin_btn_text_light"
                    android:textColor="@color/black"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/editbg"
                    android:drawablePadding="10dp"/>
                <ImageView
                    android:id="@+id/togglePassword"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:contentDescription="Toggle Password"/>
                <TextView
                    android:id="@+id/forgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textSize="14sp"
                    android:textColor="#3F51B5"
                    android:layout_marginRight="10dp"
                    android:textStyle="bold"
                    android:layout_alignParentEnd="true"
                    android:visibility="gone"
                    android:layout_below="@id/email_password"
                    android:layout_marginTop="15dp"/>

                <!-- Remember Me Checkbox -->
                <CheckBox
                    android:id="@+id/rememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remember Me"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:visibility="gone"
                    android:layout_below="@id/email_password"
                    android:layout_marginTop="15dp"
                    android:layout_alignParentStart="true"/>



                <!-- Sign In Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/signinbutton"
                    android:layout_width="340dp"
                    android:layout_height="50dp"
                    android:text="Sign In"
                    android:layout_centerHorizontal="true"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/edit_bg"
                    android:textColor="#FFFFFF"
                    android:layout_below="@id/email_password"
                    android:layout_marginTop="20dp"/>

                <!-- OR Continue With -->

                <!-- Google Sign In -->
                <ImageView
                    android:id="@+id/googleSignIn_btn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/google_icon"
                    android:layout_below="@id/signinbutton"
                    android:visibility="gone"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:id="@+id/login_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="already have account Login"
                    android:textSize="14sp"
                    android:textColor="#3F51B5"
                    android:layout_centerHorizontal="true"
                    android:layout_below="@id/googleSignIn_btn"
                    android:layout_marginTop="15dp"/>



            </RelativeLayout>



