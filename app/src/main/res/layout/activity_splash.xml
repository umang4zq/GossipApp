<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offwhite"
    android:clickable="true"
    android:focusable="true"
    tools:context=".Activity.SplashActivity">

    <ImageView
        android:id="@+id/img_1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/splash_img"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="35dp"/>
    
    
    <TextView
        android:id="@+id/txt1"
        android:layout_width="280dp"
        android:layout_height="90dp"
        android:text="Connect easily with
        your family and friends
        over countries"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:layout_below="@id/img_1"
        android:textSize="25dp"
        android:textStyle="normal"
        android:textColor="#0F1828"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/developed_by_txt"
        android:layout_width="@dimen/_230sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:textColor="@color/lapis"
        android:layout_marginTop="135dp"
        android:textSize="@dimen/_16sdp"
        android:textStyle="normal"
        android:text="Developed By"
        android:layout_below="@id/txt1"/>
    <TextView
        android:id="@+id/startmsg_btn"
        android:layout_width="@dimen/_230sdp"
        android:layout_height="@dimen/_24sdp"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:textColor="@color/lapis"
        android:textSize="@dimen/_16sdp"
        android:textStyle="normal"
        android:text="Umang Markana"
        android:layout_below="@id/developed_by_txt"/>


    
    
</RelativeLayout>