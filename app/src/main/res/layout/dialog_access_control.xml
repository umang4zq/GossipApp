<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp"
    android:background="@drawable/dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:text="Set Access Duration"
        android:textSize="@dimen/_16ssp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <Switch
        android:id="@+id/switch_pdf_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Allow PDF Download"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:elevation="@dimen/_8sdp"
        android:layout_marginTop="6dp" />

    <LinearLayout
        android:id="@+id/btnAccess1hr"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/rounded_option_bg"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="Grant for 1 Hour"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAccess24hr"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/rounded_option_bg"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="Grant for 24 Hours"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAccessPermanent"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/rounded_option_bg"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="Grant Permanent Access"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnAccessRevoke"
        android:orientation="horizontal"
        android:padding="@dimen/_10sdp"
        android:background="@drawable/rounded_red_bg"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="Revoke Access"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</LinearLayout>
