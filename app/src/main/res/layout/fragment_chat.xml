<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    tools:context=".ChatFragment">

    <TextView
        android:id="@+id/appname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GossipApp"
        android:textSize="25dp"
        android:textColor="@color/lapis"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAnnouncement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appname"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone">   <!-- HIDDEN INITIALLY -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvAnnouncementTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Update Available!"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvAnnouncementLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvAnnouncementTitle"
                android:layout_marginTop="4dp"
                android:text="Click to download the latest App"
                android:textColor="@color/lightblue"
                android:textSize="14sp"/>
            <ImageView
                android:id="@+id/btnCloseAnnouncement"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/close_ic"
                android:padding="4dp"
                android:contentDescription="Close"
                app:tint="@color/red"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        />

    <EditText
        android:id="@+id/search_user_edt"
        android:layout_width="343dp"
        android:layout_height="48dp"
        android:textSize="16dp"
        android:layout_below="@id/cardAnnouncement"
        android:background="@drawable/search_bg"
        android:hint="Search "
        android:textColorHint="@color/black"
        android:paddingLeft="5dp"
        android:layout_marginTop="22dp"
        android:textColor="@color/black"
        android:layout_centerHorizontal="true"
        />

    <ImageButton
        android:id="@+id/search_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_below="@id/appname"
        android:layout_marginLeft="-39dp"
        android:layout_marginTop="35dp"
        android:layout_toRightOf="@id/search_user_edt"
        android:background="@drawable/search_icon" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_user_rec"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_below="@id/search_user_edt"/>
    <TextView
        android:id="@+id/tv_search_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="120dp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/buttonOpenCreateGroup"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginTop="590dp"
        android:textColor="@color/white"
        android:layout_marginEnd="13dp"
        android:text="New Group" />



</RelativeLayout>