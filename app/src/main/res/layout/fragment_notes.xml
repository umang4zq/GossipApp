<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/_12sdp"
    tools:context=".NotesFragment">
    <ImageView
        android:id="@+id/ivMasterControl"
        android:layout_width="@dimen/_28sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/master_icon"
    android:visibility="gone" />

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        android:text="Assignments"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/_8sdp" />

    <!-- Search Row -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@id/tvTitle"
        android:layout_marginBottom="@dimen/_12sdp">

        <TextView
            android:id="@+id/search_btn"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_40sdp"
            android:padding="@dimen/_8sdp"
            android:elevation="@dimen/_14sdp"
            android:textColor="@color/lapis"
            android:text="Search"
            android:textSize="@dimen/_14ssp"
            android:contentDescription="Search" />

        <EditText
            android:id="@+id/search_user_edt"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="@dimen/_40sdp"
            android:hint="Search Here"
            android:paddingStart="@dimen/_10sdp"
            android:textSize="@dimen/_16ssp"
            android:background="@drawable/search_bg"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:visibility="gone" />
    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_below="@id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotes"
        android:layout_width="match_parent"
        android:layout_height="577dp"
        android:layout_below="@id/layoutSearch"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_8sdp"
      />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Add Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        app:backgroundTint="#4A90E2"
        app:srcCompat="@android:drawable/ic_input_add" />


</RelativeLayout>
